{#
  The industry builds. Every one of these is a build package with the picks
  already made, which is the whole point and is said plainly on each card
  rather than implied.

  The marker beside each included item is the same token used on the tier
  cards and the add-ons page: a blue square is a page add-on, a gold diamond
  is a power feature. Three components, one vocabulary.
#}
<div class="bundles">
  {%- for b in bundles %}
  {%- set base = packages.tiers | find("name", b.basedOn) %}
  <article class="bundle reveal" style="--d:{{ loop.index0 }}" id="{{ b.slug }}">
    <header class="bundle-head">
      <div class="ic-box">
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-{{ b.icon }}"/></svg>
      </div>
      <div class="bundle-id">
        <h3>{{ b.name }}</h3>
        <p class="bundle-trades">{{ b.trades }}</p>
      </div>
      <span class="bundle-price">
        {{ b.price | price | safe }}
        <span class="bundle-unit">one-time</span>
      </span>
    </header>

    <p class="bundle-for">{{ b.for }}</p>

    <ul class="bundle-list">
      {%- for i in b.includes %}
      <li>
        <i class="slot{% if i.kind == 'power' %} slot-hi{% endif %}" aria-hidden="true"></i>
        <span>{{ i.name }}</span>
      </li>
      {%- endfor %}
    </ul>

    <footer class="bundle-foot">
      <p class="bundle-base">
        The <a href="/packages/#{{ base.slug }}">{{ b.basedOn }} package</a>, with the
        picks already made for you.
      </p>
      <a class="btn btn-ghost btn-sm" href="/contact/?package={{ b.slug }}">
        Start with {{ b.name }}
      </a>
    </footer>
  </article>
  {%- endfor %}
</div>
