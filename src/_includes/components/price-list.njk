{#
  One group of the standalone price list. Called with `group`.

  A two-column list, not a comparison table: there is nothing to compare, only
  a thing and what it costs. The note under each name is the qualifying detail
  that decides which line you are on, so it sits with the name rather than in
  a legend somewhere else on the page.
#}
{#- `bare` drops the group header. The packages page already introduces this
    group in its own section heading, and printing the same sentence twice in
    a row reads as a template that does not know where it is. -#}
<section class="plist-group reveal" id="{{ group.slug }}">
  {%- if not bare %}
  <header class="plist-head">
    <div class="ic-box">
      <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-{{ group.icon }}"/></svg>
    </div>
    <div>
      <h2>{{ group.name }}</h2>
      <p class="body-3">{{ group.blurb }}</p>
    </div>
  </header>
  {%- endif %}

  <dl class="plist">
    {%- for i in group.items %}
    <div class="plist-row">
      <dt>
        <span class="plist-name">{{ i.name }}</span>
        {%- if i.note %}<span class="plist-note">{{ i.note }}</span>{% endif %}
      </dt>
      <dd>{{ i.price | money | safe }}</dd>
    </div>
    {%- endfor %}
  </dl>
</section>
