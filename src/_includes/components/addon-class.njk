{#
  One class of extra — page add-ons, or power features. Called with `cls`.

  Every item in a class costs the same, so the price is stated once, large, in
  the class header rather than eight times across the tiles. Repeating one
  number on every card is noise that makes a simple price look complicated.
#}
<section class="sec{% if band %} band sec-line{% endif %}" id="{{ cls.slug }}">
  <div class="wrap">

    <header class="class-head reveal">
      <div class="class-id">
        <h2>{{ cls.name }}</h2>
        <p class="lead">{{ cls.blurb }}</p>
      </div>
      <div class="class-price">
        <span class="class-amt">{{ cls.price | price | safe }}</span>
        <span class="class-unit">{{ cls.unit }}</span>
      </div>
    </header>

    <ul class="picks-grid">
      {%- for i in cls.items %}
      <li class="pick reveal" style="--d:{{ loop.index0 % 4 }}">
        <i class="slot{% if cls.slug == 'power-features' %} slot-hi{% endif %}" aria-hidden="true"></i>
        <div>
          <h3>{{ i.name }}</h3>
          <p>{{ i.blurb }}</p>
          {%- if i.service %}
          <a class="pick-link" href="/services/{{ i.service }}/">How this one works</a>
          {%- endif %}
        </div>
      </li>
      {%- endfor %}
    </ul>

  </div>
</section>
